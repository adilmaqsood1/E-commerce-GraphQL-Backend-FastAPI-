# ── Core ───────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────
DATABASE_URL=postgresql+asyncpg://ecom_user:ecom_pass@localhost:5432/ecommerce_db

# ── Redis ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ────────────────────────────────
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email (optional) ───────────────────
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@ecommerce.dev
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true
MAIL_SSL=false

# ── AI Recommendations ─────────────────
RECOMMENDATION_CACHE_TTL=3600
MIN_INTERACTIONS_FOR_CF=5
